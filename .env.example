# Copy to .env only when you want to change these defaults.
HOST=127.0.0.1
PORT=3001
STUN_URLS=stun:stun.l.google.com:19302

# Set these to your OWN TURN service for networks requiring a relay.
# Comma-separated examples: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# all = direct paths or relay; relay = force TURN for a connectivity experiment.
ICE_TRANSPORT_POLICY=all
